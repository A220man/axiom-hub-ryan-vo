# axiom-hub-ryan-vo Environment Variables
# Copy this file to .env and fill in the values

# Application
ENVIRONMENT=development
DEBUG=true
APP_NAME=axiom-hub-ryan-vo
APP_VERSION=1.0.0

# Server
HOST=0.0.0.0
PORT=8000

# Database (SQLite for development, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./data/axiom.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/axiom

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Keycloak / OIDC
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=axiom
KEYCLOAK_CLIENT_ID=axiom-frontend
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_IN_PRODUCTION
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# LLM Provider (optional)
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-llm-api-key

# Redis (for sessions/caching)
REDIS_URL=redis://localhost:6379/0